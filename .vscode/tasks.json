{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Open in Microsoft Edge (Direct)",
            "type": "shell",
            "command": "cmd /c start msedge \"http://localhost/company/index.php\"",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Ask where to open (Edge / Chrome / Default)",
            "type": "shell",
            "command": "${workspaceFolder}\\run.bat",
            "problemMatcher": []
        },
        {
            "label": "Open in Google Chrome",
            "type": "shell",
            "command": "cmd /c start chrome \"http://localhost/company/index.php\"",
            "problemMatcher": []
        },
        {
            "label": "Open in Default Browser",
            "type": "shell",
            "command": "cmd /c start \"\" \"http://localhost/company/index.php\"",
            "problemMatcher": []
        },
        {
            "label": "Open phpMyAdmin Database",
            "type": "shell",
            "command": "cmd /c start msedge \"http://localhost/phpmyadmin/\"",
            "problemMatcher": []
        }
    ]
}
